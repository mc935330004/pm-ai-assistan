<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pm.ai.assistan.auth.mapper.AuthPermissionMapper">

    <!-- 权限实体字段映射：对应 auth_permission 表。 -->
    <resultMap id="AuthPermissionResultMap" type="com.pm.ai.assistan.auth.model.AuthPermission">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="method" column="method"/>
        <result property="pathPattern" column="path_pattern"/>
        <result property="description" column="description"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 权限表基础字段，所有权限查询统一复用。 -->
    <sql id="Base_Column_List">
        id,
        code,
        name,
        method,
        path_pattern,
        description,
        created_at
    </sql>

    <!-- 查询全部接口权限，角色授权页面可以直接使用。 -->
    <select id="listPermissions" resultMap="AuthPermissionResultMap">
        select
        <include refid="Base_Column_List"/>
        from auth_permission
        order by code
    </select>

    <!-- 按权限编码查询，用于启动时判断种子权限是否存在。 -->
    <select id="findByCode" resultMap="AuthPermissionResultMap">
        select
        <include refid="Base_Column_List"/>
        from auth_permission
        where code = #{code}
    </select>

    <!-- 查询某个角色拥有的权限，角色授权页面回显时使用。 -->
    <select id="findPermissionsByRoleId" resultMap="AuthPermissionResultMap">
        select p.id,
               p.code,
               p.name,
               p.method,
               p.path_pattern,
               p.description,
               p.created_at
        from auth_permission p
        inner join auth_role_permission rp on rp.permission_id = p.id
        where rp.role_id = #{roleId}
        order by p.code
    </select>

    <!-- 根据权限 id 集合批量查询，用于角色授权提交时校验权限是否存在。 -->
    <select id="findByIds" resultMap="AuthPermissionResultMap">
        select
        <include refid="Base_Column_List"/>
        from auth_permission
        where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 查询用户最终拥有的接口权限，登录时会写入 Redis 会话。 -->
    <select id="findPermissionsByUserId" resultMap="AuthPermissionResultMap">
        select
        distinct p.id,
        p.code,
        p.name,
        p.method,
        p.path_pattern,
        p.description,
        p.created_at
        from auth_permission p
        inner join auth_role_permission rp on rp.permission_id = p.id
        inner join auth_user_role ur on ur.role_id = rp.role_id
        where ur.user_id = #{userId}
        order by p.code
    </select>

    <!-- 新增接口权限种子数据，MySQL 自增 id 会回填到 permission.id。 -->
    <insert id="insert" parameterType="com.pm.ai.assistan.auth.model.AuthPermission" useGeneratedKeys="true" keyProperty="id">
        insert into auth_permission (code, name, method, path_pattern, description)
        values (#{code}, #{name}, #{method}, #{pathPattern}, #{description})
    </insert>

    <!-- 判断角色和权限是否已绑定，启动初始化时避免重复插入。 -->
    <select id="countRolePermission" resultType="int">
        select count(1)
        from auth_role_permission
        where role_id = #{roleId}
          and permission_id = #{permissionId}
    </select>

    <!-- 给角色绑定单个接口权限，启动初始化种子数据时使用。 -->
    <insert id="insertRolePermission">
        insert into auth_role_permission (role_id, permission_id)
        values (#{roleId}, #{permissionId})
    </insert>

    <!-- 批量给角色绑定权限，管理端重新配置角色权限时使用。 -->
    <insert id="insertRolePermissions">
        insert into auth_role_permission (role_id, permission_id)
        values
        <foreach collection="permissionIds" item="permissionId" separator=",">
            (#{roleId}, #{permissionId})
        </foreach>
    </insert>

    <!-- 删除角色现有权限，重新配置角色权限前先清空关系表。 -->
    <delete id="deleteRolePermissions">
        delete from auth_role_permission
        where role_id = #{roleId}
    </delete>

</mapper>
