# 后端本地/部署环境变量示例。
# 使用时复制为 .env 或在系统环境变量中配置，不要把真实 .env 提交到代码仓库。

SPRING_PROFILES_ACTIVE=dev

# 大模型配置。开发环境不设置时可以启动，但真实聊天会因为占位 key 调用失败。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus

# MySQL 配置。
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/mc-agent?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# Redis 配置。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DATABASE=1

# 默认管理员只建议用于开发环境。
AUTH_DEFAULT_ADMIN_ENABLED=true
AUTH_DEFAULT_ADMIN_USERNAME=admin
AUTH_DEFAULT_ADMIN_PASSWORD=admin123456
AUTH_DEFAULT_ADMIN_DISPLAY_NAME=系统管理员

# 生产环境请改成真实前端域名，例如 https://agent.example.com。
AUTH_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://192.168.*.*:*

# PM 系统配置。
PM_SYSTEM_BASE_URL=http://pm.s-ic.cn/pm
PM_SYSTEM_OPENAPI_URL=http://pm.s-ic.cn/pm/v3/api-docs
